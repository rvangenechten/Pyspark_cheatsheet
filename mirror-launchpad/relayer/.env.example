# --- Robinhood Chain ---
ROBINHOOD_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=46630
GATEWAY_ADDRESS=0x...
# Must match the gateway's `relayer` address. Needs ETH for gas.
RELAYER_KEY=0x...
# Block the gateway was deployed at (first run only; later runs resume from data/journal.json)
START_BLOCK=

# --- Solana ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Deployed mirror-vault program. The backing tokens live in accounts owned by its PDA.
VAULT_PROGRAM_ID=
# Operator key: can only request capped swaps through the vault (no withdrawals). Needs SOL for fees.
OPERATOR_KEY=
# Only for `npm run admin`: one-time init / guardian pause
UPGRADE_AUTHORITY_KEY=
GUARDIAN_KEY=
SOLANA_USDC_MINT=EPjFWJd5Wt3rFpusYXYqRAa2V7NLHqGMuhgEGbSq3N9t

# --- Jupiter ---
JUPITER_API_URL=https://lite-api.jup.ag
JUPITER_API_KEY=
MAX_SLIPPAGE_BPS=300
MIN_TIME_LEFT_SEC=45

# --- API for the web app ---
PORT=8787
